# Веса модели: 33 ГБ и собственный git-репозиторий с LFS внутри
/Qwen-Image-2.1/
# Дополнительные веса: INT8-трансформер и адаптер turbo (качаются по требованию)
/Qwen-Image-2.1-INT8/
/Qwen-Image-2.1-turbo/

# Окружение
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Пользовательские данные и журналы. Каталог `user/` целиком: в нём лежат не
# только готовые картинки (`outputs/`), но и сохранённые промты (`prompts/`) —
# то и другое принадлежит человеку за машиной, а не проекту. Каталоги создаёт
# сам запуск (`config.ensure_directories`), поэтому хранить их пустыми в
# репозитории незачем.
/user/
/logs/

# Секрет: адрес и токен внешней LLM
/llm_endpoint.txt

# Справочные примеры от заказчика: чужие кадры с зашитым workflow ComfyUI,
# нужны для сравнения, но исходниками проекта не являются (57 МБ).
/samples/

# Кэш Gradio: по умолчанию он создаётся в рабочем каталоге, то есть внутри
# проекта. Оболочка туда ничего не кладёт, но сторонний запуск может.
/.gradio/

# Временные файлы прогонов: tmp_path тестов (pytest.ini), рабочие каталоги
# tools/ui_check.py, снимки и черновые скрипты. Всё временное живёт здесь, а
# не в системном %TEMP%.
/tmp/
