# Веса модели: 33 ГБ и собственный git-репозиторий с LFS внутри
/Qwen-Image-2.1/

# Окружение
/.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Пользовательские данные и журналы. Каталог `user/` целиком: в нём лежат не
# только готовые картинки (`outputs/`), но и сохранённые промты (`prompts/`) —
# то и другое принадлежит человеку за машиной, а не проекту. Каталоги создаёт
# сам запуск (`config.ensure_directories`), поэтому хранить их пустыми в
# репозитории незачем.
/user/
/logs/

# Секрет: адрес и токен внешней LLM
/llm_endpoint.txt

# Справочные примеры от заказчика: чужие кадры с зашитым workflow ComfyUI,
# нужны для сравнения, но исходниками проекта не являются (57 МБ).
/samples/
