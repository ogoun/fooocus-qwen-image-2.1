diff --git a/freevideo_engine/final_upscale.py b/freevideo_engine/final_upscale.py
new file mode 100644
index 0000000..22d366c
--- /dev/null
+++ b/freevideo_engine/final_upscale.py
@@ -0,0 +1,139 @@
+"""Optional learned upscale of the final latents before decoding (Fooocus-Qwen patch).
+
+The two-pass plan lifts a smaller first pass to the requested canvas and refines
+it there. This step comes after all sampling: the finished latents of the
+requested canvas are lifted once more by the same H3 3D v1 network and decoded
+at the larger output size. Nothing is sampled at that size, so the transformer
+never sees it; only the upscaler and the tiled decoder do.
+
+The output keeps the canvas shape: the latents are lifted by one factor that
+covers the requested width and height, then centre-cropped to it, as the
+two-pass plan crops its own lift.
+"""
+import gc
+import math
+import time
+from pathlib import Path
+
+MIN_FACTOR, MAX_FACTOR = 1., 4.
+
+
+def parse(text):
+    """'WIDTHxHEIGHT' -> dict(width, height)."""
+    try:
+        width, height = (int(value) for value in str(text).lower().split('x'))
+    except ValueError:
+        raise ValueError('Final upscale must be WIDTHxHEIGHT, for example 1728x960') from None
+    return dict(width=width, height=height)
+
+
+def plan(canvas, spec):
+    """Validate an output size against the sampled canvas; returns the lift and crop in latent units."""
+    if not isinstance(spec, dict) or any(type(spec.get(key)) is not int for key in ('width', 'height')):
+        raise ValueError('Final upscale needs integer width and height')
+    width, height = spec['width'], spec['height']
+    if width % 32 or height % 32:
+        raise ValueError('Final upscale width and height must be multiples of 32')
+    if width < canvas['width'] or height < canvas['height'] or (width, height) == (canvas['width'], canvas['height']):
+        raise ValueError('Final upscale must enlarge the video')
+    factor = max(width / canvas['width'], height / canvas['height'])
+    if not MIN_FACTOR < factor <= MAX_FACTOR:
+        raise ValueError('Final upscale supports factors above 1 and up to 4')
+    source = (canvas['height'] // 16, canvas['width'] // 16)
+    lift = tuple(max(math.ceil(side * factor - 1e-9), target)
+                 for side, target in zip(source, (height // 16, width // 16)))
+    crop = dict(top=(lift[0] - height // 16) // 2, left=(lift[1] - width // 16) // 2,
+                height=height // 16, width=width // 16)
+    return dict(width=width, height=height, factor=factor, lift=dict(height=lift[0], width=lift[1]), crop=crop)
+
+
+# The network's own temporal chunking: 32 latent frames plus its overlap on both sides.
+CHUNK_FRAMES = 32 + 2 * 5
+
+
+def workspace(canvas, spec, *, chunked=False):
+    """Conservative GPU workspace for the lift, from the two-pass estimate at the lifted size."""
+    from .two_pass import upscale_workspace
+    planned = plan(canvas, spec)
+    lifted = dict(canvas, width=planned['lift']['width'] * 16, height=planned['lift']['height'] * 16)
+    if chunked:
+        latent_frames = (canvas['frames'] - 5) // 17 * 5 + 2
+        if latent_frames > CHUNK_FRAMES:
+            # upscale_workspace counts latent frames from pixel frames: 17 frames per 5 latent ones.
+            lifted['frames'] = (CHUNK_FRAMES - 2) // 5 * 17 + 5
+    return upscale_workspace(lifted)
+
+
+def admit(canvas, spec, budget_bytes):
+    """Refuse before any work an output whose lift cannot fit even in temporal chunks."""
+    need = workspace(canvas, spec, chunked=True)
+    if budget_bytes is not None and need > budget_bytes:
+        raise ValueError('Final upscale to %dx%d needs about %.1f GiB of video memory; the budget is %.1f GiB. '
+                         'Choose a smaller output size.' % (spec['width'], spec['height'], need / 2**30,
+                                                           budget_bytes / 2**30))
+    return need
+
+
+def apply(latents, spec, canvas, checkpoint, *, available=None, memory_saving=True):
+    """Lift normalized (1, 24, T, h, w) latents to the planned output; returns (latents, metrics).
+
+    Buffer reuse keeps the original FP16 rounding, so it is always on. Temporal
+    chunking (the network's own overlap blend) is used only when the whole
+    sequence does not fit the available workspace.
+    """
+    import torch
+    from .latent_upscale import CHECKPOINT_BYTES, CHECKPOINT_SHA256, LATENTS_MEAN, LATENTS_STD, LatentResizer3D
+    from .streamed_weights import _open_safetensors
+    from .two_pass import verified_checkpoint
+    planned = plan(canvas, spec)
+    if latents.ndim != 5 or tuple(latents.shape[:2]) != (1, 24) or tuple(latents.shape[-2:]) != (
+            canvas['height'] // 16, canvas['width'] // 16):
+        raise ValueError('Final upscale received latents of another canvas')
+    checkpoint = Path(checkpoint)
+    tick = time.perf_counter()
+    if checkpoint.stat().st_size != CHECKPOINT_BYTES:
+        raise ValueError('Incomplete latent upscaler checkpoint')
+    if not verified_checkpoint(checkpoint):
+        import hashlib
+        with checkpoint.open('rb') as stream:
+            if hashlib.file_digest(stream, 'sha256').hexdigest() != CHECKPOINT_SHA256:
+                raise ValueError('The selected file is not the supported H3 3D v1 upscaler')
+    device = latents.device if latents.is_cuda else torch.device('cuda')
+    model = None
+    try:
+        with torch.device('meta'):
+            model = LatentResizer3D(reuse_buffers=memory_saving)
+        with _open_safetensors(checkpoint, framework='pt', device='cpu') as handle:
+            state = {name: handle.get_tensor(name).to(device) for name in handle.keys()}
+        model.load_state_dict({key.removeprefix('upscaler.'): value for key, value in state.items()},
+                              strict=True, assign=True)
+        del state
+        model = model.eval().requires_grad_(False).to(device=device, dtype=torch.float16)
+        torch.cuda.synchronize(device)
+        loaded = time.perf_counter() - tick
+        tick = time.perf_counter()
+        with torch.no_grad():
+            mean = torch.tensor(LATENTS_MEAN, device=device, dtype=torch.float16).view(1, -1, 1, 1, 1)
+            std = torch.tensor(LATENTS_STD, device=device, dtype=torch.float16).view(1, -1, 1, 1, 1)
+            normalized = (latents.to(device=device, dtype=torch.float16) - mean) / std
+            lift = planned['lift']
+            chunked = available is not None and available < workspace(canvas, spec)
+            result = model(normalized, scale=planned['factor'],
+                           target_size=(latents.shape[2], lift['height'], lift['width']), enable_chunking=chunked)
+            del normalized
+            crop = planned['crop']
+            result = result[..., crop['top']:crop['top'] + crop['height'], crop['left']:crop['left'] + crop['width']]
+            result = (result * std + mean).to(latents.dtype).contiguous()
+        torch.cuda.synchronize(device)
+        if not bool(torch.isfinite(result).all()):
+            raise RuntimeError('Final latent upscale produced nonfinite values')
+        metrics = dict(width=planned['width'], height=planned['height'], factor=planned['factor'],
+                       lift=planned['lift'], crop=planned['crop'], load_seconds=loaded,
+                       compute_seconds=time.perf_counter() - tick, memory_saving=memory_saving,
+                       temporal_chunking=chunked, available_workspace_bytes=available,
+                       peak_allocated_bytes=torch.cuda.max_memory_allocated(device))
+        return result, metrics
+    finally:
+        del model
+        gc.collect()
+        torch.cuda.empty_cache()
